# .deploy/opensearch/install.sh writes this, as /opt/unipept-database/etc/deploy.conf, the file the
# scripts on the host read; edit it there, as root. A clone of this repository run on its own reads
# a .deploy/deploy.conf beside the scripts instead. Neither is in this repository.
#
# Only what a host has to decide is listed. Everything the scripts already default to sensibly is
# left out, so this file cannot go stale. The defaults are in lib.sh and in each script.
#
# A flag on the command line wins over this file, and this file wins over those defaults.

# Where the finished databases are written, one directory per UniProtKB version. This volume also
# holds the whole build while it runs.
OUTPUT_DIR=/mnt/data

# load.sh: the OpenSearch instance the proteins are loaded into.
#OPENSEARCH_URL=http://localhost:9200

# build.sh: where the repositories are cloned and built.
#SCRATCH_DIR=/srv/scratch

# clone.sh: the host a finished database is copied from. Both are required to run clone.sh, here
# or as a flag.
#REMOTE_ADDRESS=selma.ugent.be
#LOCAL_SSH_KEY=/home/unipept/.ssh/id_unipept

# opensearch/install.sh: the heap the instance takes. See OPENSEARCH_HEAP there for why it is low.
#OPENSEARCH_HEAP=8g

# Uncomment to depart from the defaults.
#DATABASE_SOURCES=swissprot,trembl
#REMOTE_PORT=4840
#REMOTE_USER=unipept
#REMOTE_OUTPUT_DIR=/mnt/data

# Each source the pipeline downloads can be read from somewhere else, a mirror or a local file.
# The variable names and the URLs they replace are in pipelines/lib/sources.sh. The pipeline runs as
# a process of its own, so set them with export, for example:
#export UNIPEPT_SWISSPROT_URL=file:///srv/mirror/uniprot_sprot.dat.gz
