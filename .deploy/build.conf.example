# Copy to build.conf and edit. build.conf is not tracked.
#
# Anything already set in the environment wins over this file, and this file wins over the defaults
# in lib.sh, which is why every line uses := rather than =.

# Where the finished database is written, one directory per UniProtKB version.
: "${OUTPUT_DIR:=/mnt/data}"
# Where the repositories are cloned and the tables are built. Needs room for the whole build.
: "${SCRATCH_DIR:=$HOME}"
: "${DATABASE_SOURCES:=swissprot,trembl}"

# The OpenSearch instance the proteins are loaded into.
: "${OPENSEARCH_URL:=http://localhost:9200}"

# The host clone.sh copies a finished database from.
: "${REMOTE_ADDRESS:=}"
: "${REMOTE_PORT:=4840}"
: "${REMOTE_USER:=unipept}"
: "${REMOTE_OUTPUT_DIR:=/mnt/data}"
: "${LOCAL_SSH_KEY:=}"

# Each source the pipeline downloads can be read from somewhere else, for example a mirror or a
# local file. Unset, it uses the URL in pipelines/lib/sources.sh.
# : "${UNIPEPT_SWISSPROT_URL:=}"
# : "${UNIPEPT_TREMBL_URL:=}"
# : "${UNIPEPT_RELEASE_METALINK_URL:=}"
# : "${UNIPEPT_TAXDMP_URL:=}"
# : "${UNIPEPT_EC_CLASS_URL:=}"
# : "${UNIPEPT_EC_NUMBER_URL:=}"
# : "${UNIPEPT_GO_TERM_URL:=}"
# : "${UNIPEPT_INTERPRO_URL:=}"
# : "${UNIPEPT_REFERENCE_PROTEOME_URL:=}"
